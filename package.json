{
  "name": "serviceshare",
  "version": "0.1.0",
  "description": "Desktop WAV editor with YouTube publishing",
  "main": "dist/main/main.js",
  "private": true,
  "license": "GPL-3.0",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"cross-env NODE_ENV=development vite --config vite.renderer.config.ts\" \"cross-env NODE_ENV=development wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:audio": "vitest run --config vitest.audio.config.ts",
    "gen:assets": "node scripts/gen-assets.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamaslaszlototh/ServiceShare.git"
  },
  "keywords": [],
  "author": "Tóth Tamás László",
  "bugs": {
    "url": "https://github.com/tamaslaszlototh/ServiceShare/issues"
  },
  "homepage": "https://github.com/tamaslaszlototh/ServiceShare#readme",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "googleapis": "^185.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "build": {
    "appId": "com.tamaslaszlototh.serviceshare",
    "productName": "ServiceShare",
    "copyright": "Copyright © 2026 Tóth Tamás László",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
        "to": "licenses/ffmpeg.LICENSE.md"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.README",
        "to": "licenses/ffmpeg.README.md"
      }
    ],
    "afterPack": "scripts/packaging/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "tamaslaszlototh",
        "repo": "ServiceShare",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "forceCodeSigning": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "ffmpeg"
        },
        {
          "from": "node_modules/ffprobe-static/bin/darwin/${arch}/ffprobe",
          "to": "ffprobe"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "ffmpeg.exe"
        },
        {
          "from": "node_modules/ffprobe-static/bin/win32/x64/ffprobe.exe",
          "to": "ffprobe.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
